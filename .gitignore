# ── 操作系统 ──
Thumbs.db
desktop.ini
.DS_Store

# ── 编辑器 / IDE ──
.vscode/
.idea/
*.swp
*~

# ── WorkBuddy 本地状态不入库（工作笔记含个人信息，公开仓库不带）──
# 例外：项目技能（.workbuddy/skills/）是可复用的工作流资产，随仓库同步（2026-10-16）
.workbuddy/*
!.workbuddy/skills/
!.workbuddy/skills/**

# ── 临时 / 导出 / 中间产物 ──
_tmp/
_exports/
# 单题重传的云端备份（question-reupload 技能产生，含题图二进制，不入库）
_prev/
*.tmp
~$*
# 全库打标导出脚本：本地按需跑，不入库（2026-10-16）
/scripts/export_annotations.py

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node ──
node_modules/

# ── 试卷 PDF：根目录 PDF 只留本地，不追踪不上传 ──
/*.pdf

# ── 题目数据主体：不入库、不推送，按需另行打包分发 ──
# 例外：标签词表（data/taxonomy/）体量小且是结构化配置，随仓库同步（2026-10-15）
/data/*
!/data/taxonomy/
# taxonomy 目录内的重导入/改版备份残留，不公开
/data/taxonomy/_prev/

# ── docs 全部本地化：方案文档属内部资料，映射表/报告含真题来源与统计，公开仓库不带 ──
/docs/

# 批量下载的原始真题（性质同 data/，不入库）
downloads/

# ── 视觉切割工作目录（技能 vision-cut 的中间产物，可随时重建）──
.vision_work/
.tmp_vision/

# ── 2026-10-21 补漏：downloadPapers 之前只在旧名 downloads/ 下被忽略，
#    实际目录叫 downloadPapers/ 且已涨到 3.9G → 必须挡住，否则 git add -A 会把真题 PDF 全塞进仓库
downloadPapers/

# 部署/构建残留与手动备份（2026-10-21）
dist-new.tar
*.bak-*
*.bak
.tmp_*
# lark 导出直落根目录的临时表数据
/tbl*.ndjson
/tbl*.manifest.json
# 本地删除/重切前的整卷备份（体积大，不进仓库）
/_backup/
